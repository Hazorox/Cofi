[sub_resource type="GDScript" id="GDScript_oitky"]
script/source = "extends CanvasLayer

@onready var btn = $TextureButton
@onready var closed_label = $closed
@onready var open_label = $open

func _ready()->void:
	btn.focus_entered.connect(show_label)
	btn.mouse_entered.connect(show_label)
	
	btn.mouse_exited.connect(hide_label)
	btn.focus_exited.connect(hide_label)
	
	btn.pressed.connect(func(): get_tree().change_scene_to_file(\"res://scenes/game/game.tscn\"))

func _process(_delta:float)->void:
	if Input.is_action_just_pressed(\"interact\"):
		btn.grab_focus()


func show_label():
	open_label.visible = true
	closed_label.visible=false

func hide_label():
	open_label.visible=false
	closed_label.visible=true
"

